{
  "name": "local-ocr",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "vue-tsc --noEmit && vite build",
    "build:webkit4": "vue-tsc --noEmit && VITE_WEBKITGTK_4_0=1 vite build",
    "tauri": "tauri",
    "icons:generate": "node scripts/generate-icons.mjs",
    "sidecar:build": "python scripts/build-sidecar.py",
    "sidecar:smoke": "python scripts/smoke-sidecar.py",
    "sidecar:stage-webkit4": "python scripts/stage-webkit4-sidecar.py",
    "test:python": "python -m unittest discover -s sidecar/tests -v",
    "test:ui": "vitest run",
    "test:layout": "node scripts/check-ui-layout.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.4",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0"
  }
}
